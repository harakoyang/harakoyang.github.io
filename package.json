{
  "name": "harako-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev",
    "deploy": "wrangler pages deploy",
    "db:init": "wrangler d1 migrations apply harako --local",
    "db:migrate": "wrangler d1 migrations apply harako --remote",
    "db:migrate:preview": "wrangler d1 migrations apply harako-dev --remote --env preview",
    "tail": "wrangler pages deployment tail"
  },
  "devDependencies": {
    "wrangler": "^4.136.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260921.1": true
  }
}
