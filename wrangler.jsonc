{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "harako-site",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "observability": { "enabled": true },

  // 刻意不设 not_found_handling：默认的 "none" 会把匹配不到静态文件的路径
  // 交给 Worker，/api/* 才进得来。换成 "single-page-application" 会让
  // index.html 吞掉所有未命中路径，API 永远收不到请求。
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "972eb298ba0b49bbb3c81bbc270f647f" }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "harako",
      "database_id": "0838e0c9-98e9-4102-be3b-4bfb77c6afcc",
      "migrations_dir": "migrations"
    }
  ],

  // 每周一 01:00 UTC（台北时间 09:00）跑一次待 review 汇总。
  "triggers": { "crons": ["0 1 * * 1"] },

  "vars": {
    "SITE_URL": "https://harako.cc.cd",
    "REVIEW_WINDOW_DAYS": "7"
  }
}
