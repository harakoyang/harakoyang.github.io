{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "harako-site",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-09-22",

  // Cloudflare Pages，不再是 Worker。
  // 静态文件由 Pages 直接从 public/ 发出；/api/* 走 functions/。
  // 生产入口是 https://harako-site.pages.dev 。国内打不开 *.workers.dev，
  // *.pages.dev 可以。自订网域 harako.cc.cd / dev.harako.cc.cd 不写在这里：
  // wrangler 没有 pages domain 命令，要在 Pages 控制台挂，而且必须先把
  // 同名网域从旧 Worker 上拆掉，否则会冲突。

  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "972eb298ba0b49bbb3c81bbc270f647f" }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "harako",
      "database_id": "0838e0c9-98e9-4102-be3b-4bfb77c6afcc",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "SITE_URL": "https://harako.cc.cd"
  },

  // 顶层配置给本地 `wrangler pages dev` 和生产部署（生产分支 main）。
  // env.preview 给其余分支，目前是 dev。Pages 只有 production / preview
  // 两个环境名，不能再沿用 Worker 的 env.dev。
  //
  // KV、D1、vars 不可继承：预发只要覆盖其中一项，三项都得重写。
  // 这里预发挂的是另一套 KV 与 D1，跑 dev 不会动到生产的帐号和回报。
  // 漏写会直接部署失败，而不是悄悄连上生产库。
  "env": {
    "preview": {
      "kv_namespaces": [
        { "binding": "SESSIONS", "id": "42ba7894a1bc45d9a908b360231c114b" }
      ],

      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "harako-dev",
          "database_id": "8e3f71be-d148-46ff-823c-1d1ccc579abb",
          "migrations_dir": "migrations"
        }
      ],

      // SITE_URL 必须跟着预发域名走：OAuth 的 redirect_uri 会拿它跟请求的
      // hostname 比对，不改的话预发登入会被导回生产站。
      "vars": {
        "SITE_URL": "https://dev.harako.cc.cd"
      }
    }
  }
}
